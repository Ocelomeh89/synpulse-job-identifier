# SerpAPI (https://serpapi.com)
SERPAPI_KEY=your_serpapi_key_here

# Firecrawl (https://firecrawl.dev)
FIRECRAWL_API_KEY=your_firecrawl_key_here

# Google Sheets service account — provide ONE of the following:
#   GOOGLE_SHEETS_CREDS_PATH: path to the JSON file (local dev)
#   GOOGLE_SHEETS_CREDS_JSON: the JSON contents inline (Streamlit Cloud, CI)
GOOGLE_SHEETS_CREDS_PATH=credentials/service-account.json
# GOOGLE_SHEETS_CREDS_JSON={"type":"service_account",...}

# One env var per run, mapping run_name (uppercased) → workbook ID
GSHEET_WORKBOOK_PALANTIR_INSURANCE=replace_with_real_workbook_id
